PORT=8080
DB_PATH=chain.db
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# the JSON byte array from `solana-keygen new`, in quotes
SOLANA_KEYPAIR='[]'
PLEDGE_PER_LINK_CENTS=10
PLEDGE_CAP_CENTS=5000
CHARITY_NAME="International Institute of Minnesota"
CHARITY_URL=https://iimn.org
PLEDGER_NAME=Nazar
RATE_LIMIT_PER_HOUR=3
GLOBAL_PER_MINUTE=10
# leading zero bits the browser's proof of work must find; 0 turns it off for curl tests
POW_BITS=18
# FAKE_CHAIN=1 confirms links in memory instead of on Solana; only for frontend work
